# Copy to .env (gitignored) and fill in. Paper-trading keys only -- see CLAUDE.md and
# semis_paper_trading_brief.md's "Never trade live" boundary. This project has no live
# key, live code path, or live config option anywhere.
#
# Get paper keys from the Alpaca dashboard (https://app.alpaca.markets/paper/dashboard) --
# each paper account has its own key pair, separate from any live account's keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# S4 (BRIEF_INTRADAY.md): its own paper account, never s0/s3's -- see
# execution/alpaca_broker.py::AlpacaPaperBroker.from_env's key_env/secret_env params.
ALPACA_S4_API_KEY=
ALPACA_S4_SECRET_KEY=

# S4's headless `claude -p --bare` calls (intraday/llm.py). Metered Console billing, not
# subscription auth -- `--bare` never reads OAuth credentials (see BRIEF_INTRADAY.md's
# resolved "subscription vs API billing" open question). Set this ONLY in the CI/GitHub
# Actions environment, never in a local shell -- a locally-set ANTHROPIC_API_KEY silently
# overrides subscription auth for your own everyday interactive Claude Code usage too.
ANTHROPIC_API_KEY=
